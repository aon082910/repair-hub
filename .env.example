# Copy this file to .env and fill in real values before running docker-compose
# (or Docker/Unraid directly -- these are the same env vars either way).
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,repairhub.local

# Optional: initial Django admin superuser, created automatically on first boot.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-too

# Unraid convention: which host uid/gid should own everything under /config.
# 99/100 is Unraid's built-in "nobody" user/"users" group.
PUID=99
PGID=100
TZ=Etc/UTC
