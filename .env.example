# Copy this file to .env and fill in real values before running docker-compose
# (or Docker/Unraid directly -- these are the same env vars either way).
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=false
# Defaults to "*" (any host) if unset -- fine for a LAN-only appliance reached
# by IP. Lock it down to specific hostnames only if you're exposing this
# through a reverse proxy on the open internet.
DJANGO_ALLOWED_HOSTS=*

# Optional: initial Django admin superuser, created automatically on first boot.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-too

# Unraid convention: which host uid/gid should own everything under /config.
# 99/100 is Unraid's built-in "nobody" user/"users" group.
PUID=99
PGID=100
TZ=Etc/UTC

# Optional: outgoing email for appointment/estimate/invoice notifications.
# Leave EMAIL_HOST unset to just log emails to the container's console
# instead of sending them (fine for trying things out).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=an-app-password
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=repair-hub@yourdomain.com

# Optional: automatic business-data snapshots to /config/backups (JSON dumps,
# not a substitute for backing up the whole /config volume). Set to 0 to
# disable.
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
